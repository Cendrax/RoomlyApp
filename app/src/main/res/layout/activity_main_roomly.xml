<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00FFFFFF"
        android:orientation="vertical"
        tools:context=".MainActivity">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="30dp"
            android:paddingBottom="3dp"
            tools:ignore="UselessParent">

            <TextView
                android:id="@+id/roomlyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:text="@string/roomly"
                android:textAlignment="center"
                android:textColor="#3F51B5"
                android:textSize="34sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:backgroundTint="#00FFFFFF"
                app:srcCompat="@drawable/baseline_menu_24"
                tools:ignore="ContentDescription,TouchTargetSizeCheck" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/profileIconButton"
                android:layout_width="76dp"
                android:layout_height="66dp"
                android:background="#00FFFFFF"
                app:srcCompat="@drawable/outline_account_circle_24" />

            <TextView
                android:id="@+id/profileNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:paddingTop="20dp"
                android:text="@string/profile_name_label"
                android:textAlignment="textStart"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/divider"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#00FFFFFF" />

            <ImageButton
                android:id="@+id/notificationButton"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center"
                android:layout_weight="0"
                android:background="#00FFFFFF"
                android:padding="5dp"
                app:srcCompat="@drawable/notification_icon" />

            <ImageButton
                android:id="@+id/chatButton"
                android:layout_width="53dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center"
                android:layout_weight="0"
                android:background="#00FFFFFF"
                android:padding="5dp"
                app:srcCompat="@drawable/chat_icon" />

            <ImageButton
                android:id="@+id/favoritesButton"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center"
                android:layout_weight="0"
                android:background="#00FFFFFF"
                android:padding="5dp"
                app:srcCompat="@drawable/outline_favorite_24" />

        </LinearLayout>

        <SearchView
            android:id="@+id/seachbar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="10dp"
            android:layout_weight="0"
            android:background="@drawable/search_view" />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:id="@+id/rvProfiles"/>
    </LinearLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:menu="@menu/menu_panel"
        app:headerLayout="@layout/nav_header"/>
</androidx.drawerlayout.widget.DrawerLayout>